AnyKernel3/tools/ak3-core.sh
AnyKernel3/tools/magiskboot
AnyKernel3/tools/busybox
AnyKernel3/modules/
AnyKernel3/patch/
AnyKernel3/ramdisk/
AnyKernel3/anykernel.sh
AnyKernel3/Image*
AnyKernel3/zImage*
AnyKernel3/dtb/
AnyKernel3/META-INF/com/google/android/update-binary
AnyKernel3/META-INF/com/google/android/updater-script

# ── Editor & OS ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
build.log

# ── Local config overrides ────────────────────────────────────────────────────
