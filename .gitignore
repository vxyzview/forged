# ── Go ────────────────────────────────────────────────────────────────────────
# Compiled binary produced by `go build` / `go install` (repo root only)
/forged
/forged.exe
*.exe
*.test
*.out
*.prof

# ── Go workspace / tooling ────────────────────────────────────────────────────
vendor/
go.work
go.work.sum

# ── Build artefacts ───────────────────────────────────────────────────────────
# Kernel build output
out/

# Packaged flashable ZIPs
releases/

# Fixture build artefacts (CI smoke-test kernel tree)
test/fixtures/kernel-fixture/out/
test/fixtures/kernel-fixture/releases/
test/fixtures/kernel-fixture/AnyKernel3/

# Toolchains managed by forged setup-toolchain
# (stored in ~/.local/share/forged/ by default, but may be local)
toolchains/

# ── AnyKernel3 staging ────────────────────────────────────────────────────────
# The staging area is populated per-build from anykernel3.source
# (osm0sis clone, git fork, local checkout, or stub skeleton).
# Ignore everything generated — only the committed skeleton stays tracked.
AnyKernel3/tools/
AnyKernel3/modules/
AnyKernel3/patch/
AnyKernel3/ramdisk/
AnyKernel3/anykernel.sh
AnyKernel3/Image*
AnyKernel3/zImage*
AnyKernel3/dtb/
AnyKernel3/META-INF/
!AnyKernel3/README.md
!AnyKernel3/.gitkeep

# ── Editor & OS ───────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
build.log

# ── Local config overrides ────────────────────────────────────────────────────
# User-created configs should not be committed unless intended
build_config.json
build_config.toml
